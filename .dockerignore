# Build artifacts
/target/
*.pdb
*.dll
*.so
*.dylib
*.rlib

# Sensitive environment files
.env
.env.*

# Development
/node_modules/
/.vscode/
/.idea/
*.swp
*.swo
*~
.DS_Store

# Git
/.git/
/.gitignore
/.gitattributes

# CI/CD
/.github/

# Python — `**/` prefix: .dockerignore patterns are context-root-anchored
# and `*` never crosses `/`, so nested caches (pkg/__pycache__/) entered
# the build context anyway.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/venv/
**/.venv/

# Logs
**/*.log

# Generated
/outputs/
/tmp/

# Local runtime state

# Claude Code artifacts
/.claude/
/.ace-tool/

# Credentials / keys (defense-in-depth before COPY . .)
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/.npmrc
**/.pypirc
**/.aws/
**/.ssh/
/secrets/
**/*kubeconfig*

# Documentation (not needed at runtime)
/docs/
/website/
/*.md
!/README.md
!/CHANGELOG.md

# Assets (screenshots, etc.)
/assets/

# Scripts
/scripts/

# Development configs
/.devcontainer/
/config.example.toml
