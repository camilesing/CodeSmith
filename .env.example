# DeepSeek TUI environment
# Shell-exported variables override values in this file.
# Copy this file to `.env`, then uncomment only the values you want to use.
# `CODESMITH_PROVIDER` / `CODESMITH_MODEL` / `CODESMITH_BASE_URL` are equivalent
# aliases that take precedence over their `DEEPSEEK_*` counterparts.

# DeepSeek API (default provider)
# Get an API key from DeepSeek, then keep it local in `.env`.
# DEEPSEEK_API_KEY=

# Official DeepSeek Platform host (see api-docs.deepseek.com); `deepseek-cn` uses the same host.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_PROVIDER=deepseek-cn

# V4 model selection. Compatibility aliases such as `deepseek-chat` normalize
# to the current V4 flash model in the TUI.
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# NVIDIA NIM-hosted DeepSeek V4
# Use this provider when routing through NVIDIA's OpenAI-compatible endpoint.
# DEEPSEEK_PROVIDER=nvidia-nim
# NVIDIA_API_KEY=
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-pro

# AtlasCloud OpenAI-compatible endpoint
# DEEPSEEK_PROVIDER=atlascloud
# ATLASCLOUD_API_KEY=
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1
# ATLASCLOUD_MODEL=deepseek-ai/deepseek-v4-flash

# OpenAI-compatible gateways (provider: openai)
# Generic OpenAI-compatible route for gateways and custom endpoints.
# DEEPSEEK_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# DEEPSEEK_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Key alias: CLAUDE_API_KEY.

# Volcengine Ark coding endpoint
# DEEPSEEK_PROVIDER=volcengine
# VOLCENGINE_API_KEY=
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# Key aliases: VOLCENGINE_ARK_API_KEY / ARK_API_KEY.
# Base URL aliases: VOLCENGINE_ARK_BASE_URL / ARK_BASE_URL.
# VOLCENGINE_MODEL=DeepSeek-V4-Pro

# Wanjie ARK OpenAI-compatible endpoint
# DEEPSEEK_PROVIDER=wanjie-ark
# WANJIE_ARK_API_KEY=
# WANJIE_ARK_BASE_URL=https://maas-openapi.wanjiedata.com/api/v1
# Key aliases: WANJIE_API_KEY / WANJIE_MAAS_API_KEY.
# Base URL aliases: WANJIE_BASE_URL / WANJIE_MAAS_BASE_URL.
# WANJIE_ARK_MODEL=deepseek-reasoner

# OpenRouter open-model routing
# DEEPSEEK_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Xiaomi MiMo
# DEEPSEEK_PROVIDER=xiaomi-mimo
# XIAOMI_MIMO_API_KEY=
# XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Key aliases: XIAOMI_API_KEY / MIMO_API_KEY.
# Base URL alias: MIMO_BASE_URL.
# XIAOMI_MIMO_MODEL=mimo-v2.5-pro

# Novita AI hosted DeepSeek
# DEEPSEEK_PROVIDER=novita
# NOVITA_API_KEY=
# NOVITA_BASE_URL=https://api.novita.ai/v1

# Fireworks AI hosted DeepSeek
# DEEPSEEK_PROVIDER=fireworks
# FIREWORKS_API_KEY=
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# SiliconFlow
# DEEPSEEK_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
# Regional endpoint: https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Moonshot Kimi
# DEEPSEEK_PROVIDER=moonshot
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Key alias: KIMI_API_KEY. Base URL alias: KIMI_BASE_URL.
# Kimi Code endpoint: https://api.kimi.com/coding/v1 (model kimi-for-coding)
# MOONSHOT_MODEL=kimi-k2.6

# Self-hosted OpenAI-compatible runtimes (API keys optional on localhost)
# DEEPSEEK_PROVIDER=sglang
# SGLANG_API_KEY=
# SGLANG_BASE_URL=http://localhost:30000/v1
# DEEPSEEK_PROVIDER=vllm
# VLLM_API_KEY=
# VLLM_BASE_URL=http://localhost:8000/v1
# DEEPSEEK_PROVIDER=ollama
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Logging
# `DEEPSEEK_LOG_LEVEL` is forwarded by the facade; `RUST_LOG` enables the
# TUI's lightweight verbose logs for info/debug/trace directives.
# DEEPSEEK_LOG_LEVEL=debug
# RUST_LOG=deepseek_tui=debug

# Agent safety defaults
# `on-request` asks before higher-risk work; `workspace-write` keeps writes
# inside the workspace unless a sandbox elevation path is explicitly used.
# DEEPSEEK_APPROVAL_POLICY=on-request
# DEEPSEEK_SANDBOX_MODE=workspace-write
# DEEPSEEK_ALLOW_SHELL=true
# DEEPSEEK_YOLO=true

# Provider request overrides (win over the same-named providers.toml settings)
# DEEPSEEK_HTTP_HEADERS=X-Custom=a,X-Other=b
# DEEPSEEK_OUTPUT_MODE=
# DEEPSEEK_AUTH_MODE=
# DEEPSEEK_TELEMETRY=false

# Web search API keys
# DEEPSEEK_SEARCH_API_KEY=
# METASO_API_KEY=
# BAIDU_SEARCH_API_KEY=

# Optional extension paths
# DEEPSEEK_SKILLS_DIR=~/.deepseek/skills
# DEEPSEEK_MCP_CONFIG=~/.deepseek/mcp.json
