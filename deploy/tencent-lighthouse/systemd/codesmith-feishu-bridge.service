[Unit]
Description=CodeSmith Feishu/Lark Phone Bridge
Wants=network-online.target codesmith-runtime.service
After=network-online.target codesmith-runtime.service

[Service]
Type=simple
User=codesmith
Group=codesmith
WorkingDirectory=/opt/codesmith/bridge
EnvironmentFile=/etc/codesmith/feishu-bridge.env
ExecStart=/usr/bin/node /opt/codesmith/bridge/src/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/codesmith-feishu-bridge

[Install]
WantedBy=multi-user.target
