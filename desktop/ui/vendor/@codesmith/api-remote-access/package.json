{
  "name": "@codesmith/api-remote-access",
  "description": "Method-level Remote access control for non-owner Peers and the per-Peer access snapshot",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "codesmith": {
    "client": {
      "external": [
        "@codesmith/api-gateway/client"
      ],
      "inject": [
        "@codesmith/api-gateway",
        "@codesmith/client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@codesmith/typert-protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/api-gateway": "workspace:*",
    "@codesmith/client-connection": "workspace:*",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "@codesmith/typert-registry": "workspace:*"
  }
}
