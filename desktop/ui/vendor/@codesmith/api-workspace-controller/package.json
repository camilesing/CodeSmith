{
  "name": "@codesmith/api-workspace-controller",
  "description": "Workspace Remote commands and reconnect-safe state transport",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./default-workspace": {
      "types": "./lib/types/default-workspace.d.ts",
      "default": "./lib/types/default-workspace.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "external": [
        "@codesmith/api-gateway/client"
      ],
      "inject": [
        "@codesmith/api-gateway",
        "@codesmith/client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@codesmith/deque": "workspace:*",
    "@codesmith/native-command": "workspace:*",
    "@codesmith/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/api-gateway": "workspace:*",
    "@codesmith/client-connection": "workspace:*",
    "@codesmith/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/api-gateway": "workspace:*",
    "@codesmith/api-remote-access": "workspace:*",
    "@codesmith/client-connection": "workspace:*",
    "@codesmith/client-store": "workspace:*",
    "@codesmith/typert-protocol": "workspace:*"
  }
}
