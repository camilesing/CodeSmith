{
  "name": "@codesmith/client-resources",
  "description": "Unified client resource model: protocol-registered providers turn URL addresses into live values, consumed through the useResource global standard hook",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "inject": [
        "@codesmith/client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/client-store": "workspace:*",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "@codesmith/typert-protocol": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
