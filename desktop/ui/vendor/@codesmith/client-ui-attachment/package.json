{
  "name": "@codesmith/client-ui-attachment",
  "description": "Dynamic attachment presentation plugin for conversation input, message-image, and trajectory image slots",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "inject": [
        "@codesmith/client-locale",
        "@codesmith/client-ui-chat",
        "@codesmith/client-ui-conversation",
        "@codesmith/client-ui-renderer",
        "@codesmith/client-ui-trajectory",
        "@codesmith/client-ui-tool",
        "@codesmith/client-ui-file-drag",
        "@codesmith/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/client-locale": "workspace:*",
    "@codesmith/client-ui-chat": "workspace:*",
    "@codesmith/client-ui-conversation": "workspace:*",
    "@codesmith/client-ui-trajectory": "workspace:*",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/client-ui-primitives": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@codesmith/client-ui-tool": "workspace:*",
    "clsx": "^2.0.0",
    "@codesmith/client-ui-file-drag": "workspace:*",
    "@codesmith/util-file-drag": "workspace:*",
    "@codesmith/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  }
}
