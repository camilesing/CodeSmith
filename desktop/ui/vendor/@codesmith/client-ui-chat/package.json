{
  "name": "@codesmith/client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./assets/*": "./lib/assets/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "inject": [
        "@codesmith/api-session-controller",
        "@codesmith/api-workspace-controller",
        "@codesmith/client-connection",
        "@codesmith/client-locale",
        "@codesmith/client-ui-conversation",
        "@codesmith/client-ui-input-trigger",
        "@codesmith/client-ui-layout",
        "@codesmith/client-ui-renderer",
        "@codesmith/client-ui-session",
        "@codesmith/client-ui-settings",
        "@codesmith/client-ui-sidebar-right",
        "@codesmith/client-ui-workspace",
        "@codesmith/client-ui-file-drag",
        "@codesmith/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/api-remotes": "workspace:*",
    "@codesmith/api-session-controller": "workspace:*",
    "@codesmith/api-workspace-controller": "workspace:*",
    "@codesmith/api-workspace-files": "workspace:*",
    "@codesmith/brand": "workspace:*",
    "@codesmith/client-connection": "workspace:*",
    "@codesmith/client-locale": "workspace:*",
    "@codesmith/client-store": "workspace:*",
    "@codesmith/client-ui-approval": "workspace:*",
    "@codesmith/client-ui-conversation": "workspace:*",
    "@codesmith/client-ui-input-trigger": "workspace:*",
    "@codesmith/client-ui-layout": "workspace:*",
    "@codesmith/client-ui-primitives": "workspace:*",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/client-ui-session": "workspace:*",
    "@codesmith/client-ui-settings": "workspace:*",
    "@codesmith/client-ui-sidebar-documentpreview": "workspace:*",
    "@codesmith/client-ui-sidebar-right": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "@codesmith/client-ui-workspace": "workspace:*",
    "@codesmith/util-workspace-path": "workspace:*",
    "@codesmith/util-values": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@codesmith/client-ui-file-drag": "workspace:*",
    "@codesmith/client-ui-context-menu": "workspace:*"
  },
  "dependencies": {
    "@codesmith/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "lib/types/**/*.d.ts"
  ]
}
