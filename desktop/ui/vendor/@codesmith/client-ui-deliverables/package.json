{
  "name": "@codesmith/client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "inject": [
        "@codesmith/api-remotes",
        "@codesmith/client-connection",
        "@codesmith/client-locale",
        "@codesmith/client-ui-chat",
        "@codesmith/client-ui-conversation",
        "@codesmith/client-ui-renderer",
        "@codesmith/client-ui-sidebar-right",
        "@codesmith/client-ui-tool",
        "@codesmith/client-ui-settings",
        "@codesmith/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/api-remotes": "workspace:*",
    "@codesmith/client-connection": "workspace:*",
    "@codesmith/client-locale": "workspace:*",
    "@codesmith/client-store": "workspace:*",
    "@codesmith/client-ui-chat": "workspace:*",
    "@codesmith/client-ui-conversation": "workspace:*",
    "@codesmith/client-ui-dockkit": "workspace:*",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/client-ui-sidebar-right": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "@codesmith/cordis": "workspace:~",
    "react": "^18.2.0",
    "@codesmith/client-ui-primitives": "workspace:*",
    "@codesmith/client-ui-tool": "workspace:*",
    "@codesmith/api-session-controller": "workspace:*",
    "@codesmith/util-values": "workspace:*",
    "@codesmith/util-workspace-path": "workspace:*",
    "@codesmith/api-workspace-files": "workspace:*",
    "@codesmith/client-ui-settings": "workspace:*",
    "@codesmith/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@codesmith/typert-protocol": "workspace:*"
  }
}
