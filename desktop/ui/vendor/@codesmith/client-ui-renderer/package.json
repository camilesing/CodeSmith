{
  "name": "@codesmith/client-ui-renderer",
  "description": "Browser UI renderer: React slot bindings, ctx.uiRenderer, and the assembled application root",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/client-ui-slots": "workspace:*",
    "@types/use-sync-external-store": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "use-sync-external-store": "1.6.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
