{
  "name": "@codesmith/client-ui-settings-models",
  "description": "Models settings and shared product-onboarding dialogs over existing settings and credential joins",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "inject": [
        "@codesmith/client-ui-settings",
        "@codesmith/client-locale",
        "@codesmith/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/api-remotes": "workspace:*",
    "@codesmith/client-locale": "workspace:*",
    "@codesmith/client-store": "workspace:*",
    "@codesmith/client-ui-primitives": "workspace:*",
    "@codesmith/client-ui-settings": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "@codesmith/cordis": "workspace:~",
    "react": "^18.2.0",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/util-values": "workspace:*"
  },
  "dependencies": {
    "@codesmith/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
