{
  "name": "@codesmith/client-ui-sidebar-right",
  "description": "Right Sidebar: the docking surface's session-bound state, its panel and header expand control, and the navigation service over it",
  "version": "0.2.2-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "codesmith": {
    "client": {
      "inject": [
        "@codesmith/api-session-controller",
        "@codesmith/client-resources",
        "@codesmith/client-ui-conversation",
        "@codesmith/client-ui-layout",
        "@codesmith/client-ui-session",
        "@codesmith/client-shortcuts",
        "@codesmith/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis": "workspace:~"
  },
  "devDependencies": {
    "@codesmith/cordis": "workspace:~",
    "@codesmith/api-session-controller": "workspace:*",
    "@codesmith/client-locale": "workspace:*",
    "@codesmith/client-resources": "workspace:*",
    "@codesmith/client-store": "workspace:*",
    "@codesmith/client-ui-conversation": "workspace:*",
    "@codesmith/client-ui-dockkit": "workspace:*",
    "@codesmith/client-ui-layout": "workspace:*",
    "@codesmith/client-ui-primitives": "workspace:*",
    "@codesmith/client-ui-renderer": "workspace:*",
    "@codesmith/client-ui-session": "workspace:*",
    "@codesmith/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/picomatch": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "picomatch": "^4.0.7",
    "clsx": "^2.0.0",
    "@codesmith/util-crypto": "workspace:*",
    "zod": "4.4.3",
    "@codesmith/client-shortcuts": "workspace:*",
    "@codesmith/brand": "workspace:*",
    "@codesmith/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
