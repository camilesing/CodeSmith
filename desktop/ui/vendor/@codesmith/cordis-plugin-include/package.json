{
  "name": "@codesmith/cordis-plugin-include",
  "description": "Include files in cordis configurations",
  "version": "1.0.11-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@codesmith/cordis-plugin-loader": "workspace:~",
    "@codesmith/cordis": "workspace:~"
  },
  "dependencies": {
    "@codesmith/cosmokit": "workspace:~",
    "js-yaml": "^4.1.0"
  }
}
