{
  "name": "codesmith",
  "version": "0.1.0",
  "codesmithBinaryVersion": "0.1.0",
  "description": "Install and run CodeSmith, the agentic terminal for open-source and open-weight coding models, from GitHub release artifacts.",
  "author": "camilesing",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/camilesing"
    }
  ],
  "homepage": "https://github.com/camilesing/CodeSmith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camilesing/CodeSmith.git"
  },
  "bugs": {
    "url": "https://github.com/camilesing/CodeSmith/issues"
  },
  "keywords": [
    "codesmith",
    "cli",
    "rust",
    "binary",
    "terminal"
  ],
  "type": "commonjs",
  "bin": {
    "codesmith": "bin/codesmith.js"
    
  },
  "scripts": {
    "release:check": "node scripts/verify-release-assets.js",
    "postinstall": "node scripts/install.js --optional",
    "prepublishOnly": "node scripts/verify-release-assets.js",
    "prepack": "node scripts/install.js --optional",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/*.js",
    "scripts/*.js",
    "README.md",
    "package.json"
  ]
}
